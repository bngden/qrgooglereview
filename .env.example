DATABASE_URL=postgresql://user:pass@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
APP_URL=https://your-domain.com
JWT_SECRET=change_me_to_at_least_32_random_bytes_here
SCAN_SALT=change_me_to_at_least_32_random_bytes_here
CRON_SECRET=change_me_to_at_least_32_random_bytes_here
GOOGLE_PLACES_API_KEY=
# Hard-stop kuota harian Text Search Pro (PRD §6.2 — set ≈150 di Google Cloud juga)
GOOGLE_PLACES_DAILY_QUOTA=150
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_to_secure_password
SAFE_BROWSING_API_KEY=
RESEND_API_KEY=

# Mode mock frontend (hanya untuk lingkungan tanpa database / uji UI).
# NEXT_PUBLIC_USE_MOCK=1   -> semua endpoint (public + admin) memakai mock
# NEXT_PUBLIC_MOCK_GROUPS  -> daftar kelompok yang di-mock, pisahkan koma (contoh: admin)
# Catatan: mock admin menonaktifkan pemeriksaan sesi di middleware HANYA saat NODE_ENV != production.
NEXT_PUBLIC_USE_MOCK=
NEXT_PUBLIC_MOCK_GROUPS=
